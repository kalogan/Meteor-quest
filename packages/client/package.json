{
  "name": "@meteor/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --open /preview.html",
    "build": "tsc --noEmit && vite build",
    "build:preview": "vite build --config vite.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@meteor/shared": "workspace:*",
    "@meteor/sim-core": "workspace:*",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.171.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^6.2.0",
    "vitest": "^2.1.8"
  }
}
